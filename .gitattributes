# Every text file uses LF line endings in the repository and in every checkout, on every platform.
* text=auto eol=lf

# Binary files are never converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.docx binary
*.xlsx binary

# cmd.exe needs CRLF to parse batch labels; PowerShell scripts follow for consistency on Windows.
*.cmd text eol=crlf
*.ps1 text eol=crlf
